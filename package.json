{
  "name": "jk-test",
  "displayName": "jk-test",
  "description": "",
  "version": "1.2.4",
  "icon": "media/icon.png",
  "publisher": "JKTesting",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:jk-test.jk-agent"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "jk-test.jk-agent",
        "fullName": "JK Test QA Agent",
        "name": "JKAgent",
        "description": "Let's check your code.",
        "isSticky": true,
        "commands": [
          {
            "name": "vulnerabilities",
            "description": "Analyze the code for vulnerabilities."
          },
          {
            "name": "oversights",
            "description": "Analyze the code for oversights or edge cases."
          },
          {
            "name": "testdata",
            "description": "Parameterize a test and add realistic test data."
          },
          {
            "name": "test",
            "description": "Generate and run pytest tests for user provided code."
          },
          {
            "name": "all",
            "description": "Run a full check that combines the vulnerabilities and oversights prompts."
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "jk-test.testWithJK",
        "title": "Test with JK-Testing"
      },
      {
        "command": "jk-test.testWithJKVulnerabilities",
        "title": "Test with JK-Testing: Vulnerabilities"
      },
      {
        "command": "jk-test.testWithJKOversights",
        "title": "Test with JK-Testing: Oversights"
      },
      {
        "command": "jk-test.testWithJKTestData",
        "title": "Test with JK-Testing: Test Data"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "jk-test.testWithJK",
          "group": "jkTesting@1",
          "when": "editorHasSelection"
        },
        {
          "command": "jk-test.testWithJKVulnerabilities",
          "group": "jkTesting@2",
          "when": "editorHasSelection"
        },
        {
          "command": "jk-test.testWithJKOversights",
          "group": "jkTesting@3",
          "when": "editorHasSelection"
        },
        {
          "command": "jk-test.testWithJKTestData",
          "group": "jkTesting@4",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "test": "vscode-test",
    "deploy": "vsce publish minor --no-git-tag-version"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "@vscode/chat-extension-utils": "0.0.0-alpha.5",
    "add": "^2.0.6",
    "eslint": "^9.39.2",
    "or": "^0.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "yarn": "^1.22.22"
  },
  "extensionDependencies": [
    "vscode.git"
  ]
}